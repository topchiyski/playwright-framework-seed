# Copy to `.env` (shared) and/or `.env.<TEST_ENV>` (per-environment override).
# Precedence and every variable: docs/reference.md (sections "Configuration precedence", "Environment variables").
# All values are validated by the Zod schema in src/config/env.ts at startup. Empty values count as unset.

# Target environment: qa | staging | prod
TEST_ENV=qa

# --- Secrets (never commit real values) ---
# TODO: replace with your application's test credentials, or rename/remove them in
# src/config/env.ts (`credentials`) if your app authenticates differently.
UI_PASSWORD=replace-me
API_USERNAME=replace-me
API_PASSWORD=replace-me

# --- Optional overrides of config/<env>.ts ---
# BASE_URL=https://your-app.example.com
# API_BASE_URL=https://api.your-app.example.com
# WORKERS=4
# RETRIES=1
# HEADLESS=true
# LOG_LEVEL=info
