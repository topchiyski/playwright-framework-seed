# Copy to `.env` (shared) and/or `.env.<TEST_ENV>` (per-environment override).
# Precedence and every variable: docs/reference.md (sections "Configuration precedence", "Environment variables").
# All values are validated by the Zod schema in src/config/env.ts at startup.

# Target environment: qa | staging | prod
TEST_ENV=qa

# --- Secrets (never commit real values) ---
# Password shared by all SauceDemo demo users
UI_PASSWORD=secret_sauce
# Restful-Booker admin credentials
API_USERNAME=admin
API_PASSWORD=password123

# --- Optional overrides of config/<env>.ts ---
# BASE_URL=https://www.saucedemo.com
# API_BASE_URL=https://restful-booker.herokuapp.com
# WORKERS=4
# RETRIES=1
# HEADLESS=true
# LOG_LEVEL=info
